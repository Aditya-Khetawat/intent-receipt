NODE_ENV=development
APP_BASE_URL=http://localhost:3000
DEMO_MODE=true

# PayPal sandbox (developer.paypal.com > Apps & Credentials > Sandbox)
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
# Only honoured when NODE_ENV=development
WEBHOOK_VERIFY=on

# Runtime AI (the product's AI). google = free Google AI Studio key.
AI_PROVIDER=google
GOOGLE_GENERATIVE_AI_API_KEY=
ANTHROPIC_API_KEY=
AI_MODEL_AGENT=gemini-3.5-flash
AI_MODEL_ANALYST=gemini-3.5-flash
AI_DAILY_BUDGET_CALLS=300

# Ed25519 signing key for the intent ledger: run `npm run gen-keys`
INTENT_SIGNING_KEY=
INTENT_KEY_ID=ir-key-1
DATABASE_PATH=./data/intentreceipt.db

# Optional: a header the host guarantees holds the real client IP (e.g. cf-connecting-ip).
# Unset = rightmost X-Forwarded-For hop. Used only for rate limiting.
TRUSTED_CLIENT_IP_HEADER=

AG_GRID_LICENSE_KEY=
